# Application configuration
NODE_ENV=development
APP_NAME=Mailhub
APP_DOMAIN=private-mailhub.com
PORT=8080

# Database configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=private_mailhub
DATABASE_USERNAME=root
DATABASE_PASSWORD=change-me

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# Authentication and encryption
JWT_SECRET=replace-with-a-long-random-secret
VERIFICATION_CODE_EXPIRATION=300000
VERIFICATION_CODE_MAX_ATTEMPTS=3
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Email addresses
NO_REPLY_ADDRESS=noreply@private-mailhub.com
CONTACT_ADDRESS=contact@private-mail.com

# AWS configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_EMAIL_BUCKET=your-s3-bucket-name
AWS_SQS_QUEUE_NAME=your-sqs-queue-name
AWS_SQS_QUEUE_URL=https://sqs.region.amazonaws.com/account-id/queue-name

# Used by local/non-production email delivery
AWS_SES_FROM_EMAIL=noreply@private-mailhub.com

# Production outbound email (required when NODE_ENV=production)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_BASE_URL=https://api.mailgun.net

# Optional OAuth configuration
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=

# CORS configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
